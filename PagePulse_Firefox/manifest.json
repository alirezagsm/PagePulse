{
    "manifest_version": 3,
    "name": "PagePulse",
    "version": "1.0",
    "description": "Reloads the current page at a specified time frequency.",
    "permissions": [
        "storage",
        "tabs",
        "activeTab"
    ],
    "background": {
        "scripts": [
            "src/background.js"
        ]
    },
    "action": {
        "default_popup": "src/popup/popup.html",
        "default_icon": {
            "128": "images/reload.png"
        }
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "src/content.js"
            ]
        }
    ],
    "icons": {
        "128": "images/reload.png"
    },
    "browser_specific_settings": {
        "gecko": {
            "id": "pagepulse@addon.com",
            "data_collection_permissions": {
                "required": [
                    "none"
                ]
            }
        }
    }
}